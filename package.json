{
  "name": "mengxi-uni-ui",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Vue 3 + TypeScript 的高质量 uni-app 组件库",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "build:core": "pnpm --filter @mengxi/uni-ui run build",
    "dev:docs": "pnpm --filter @mengxi/uni-ui-docs run dev",
    "build:docs": "pnpm --filter @mengxi/uni-ui-docs run build",
    "dev:playground": "pnpm --filter @mengxi/uni-ui-playground run dev:h5",
    "build:playground": "pnpm --filter @mengxi/uni-ui-playground run build:h5",
    "release": "bumpp",
    "lint": "pnpm -r run lint",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"**/*.{ts,vue,scss,md}\"",
    "prepare": "husky",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "clean": "rimraf --glob node_modules pnpm-lock.yaml packages/**/node_modules packages/**/pnpm-lock.yaml"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "husky"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "bumpp": "^10.4.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.17.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.3.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.2.2",
    "vue-eslint-parser": "^9.4.2"
  },
  "author": {
    "name": "PedroQue99",
    "email": "ksmengfang@163.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MengXi-Studio/uni-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MengXi-Studio/uni-ui.git"
  },
  "bugs": "https://github.com/MengXi-Studio/uni-ui/issues"
}
