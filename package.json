{
  "name": "@mengxi/uni-ui",
  "version": "0.1.0",
  "description": "MengXi Uni-UI 组件库 - 基于 Vue 3 + TypeScript 的高质量 uni-app 组件库",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "packages/components",
    "packages/utils",
    "packages/composables",
    "packages/styles"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "rollup --config rollup.config.ts --configPlugin typescript",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "build:example": "vite build example",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint packages/**/*.{ts,vue}",
    "format": "prettier --write \"packages/**/*.{ts,vue,scss}\"",
    "prepare": "husky install"
  },
  "keywords": [
    "uni-app",
    "vue3",
    "typescript",
    "ui-components",
    "mobile",
    "cross-platform",
    "mengxi"
  ],
  "author": "MengXi Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MengXi-Studio/mengxi-uni-ui.git"
  },
  "bugs": {
    "url": "https://github.com/MengXi-Studio/mengxi-uni-ui/issues"
  },
  "homepage": "https://github.com/MengXi-Studio/mengxi-uni-ui#readme",
  "peerDependencies": {
    "vue": "^3.2.0",
    "uni-app": "^3.0.0"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "^3.0.0-alpha-3092920230817001",
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-typescript": "^11.1.3",
    "@types/node": "^20.5.9",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "husky": "^8.0.3",
    "prettier": "^3.0.3",
    "rollup": "^3.29.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-postcss": "^4.0.1",
    "rollup-plugin-vue": "^6.0.0",
    "sass": "^1.66.1",
    "terser": "^5.19.2",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vitest": "^0.34.4",
    "vue": "^3.3.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
