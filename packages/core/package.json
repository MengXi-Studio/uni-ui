{
  "name": "@mengxi/uni-ui",
  "version": "0.1.0",
  "description": "MengXi Uni-UI — 基于 Vue 3 + TypeScript 的高质量 uni-app 组件库（core 子包）",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles/*": "./src/styles/*",
    "./utils": "./src/utils/index.ts",
    "./composables": "./src/composables/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "rollup --config rollup.config.ts --configPlugin typescript",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "lint": "eslint src/**/*.{ts,vue}",
    "test": "vitest"
  },
  "keywords": [
    "uni-app",
    "vue3",
    "typescript",
    "ui-components",
    "mobile",
    "cross-platform",
    "mengxi"
  ],
  "author": "MengXi Studio",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "eslint": "^8.48.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.3",
    "sass": "^1.66.1",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vitest": "^0.34.4",
    "vue": "^3.3.4"
  }
}