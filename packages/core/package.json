{
  "name": "@mengxi/uni-ui",
  "version": "0.1.0",
  "description": "基于 Vue 3 + TypeScript 的高质量 uni-app 组件库",
  "keywords": [
    "@mengxi/uni-ui",
    "meng-xi",
    "uni-ui",
    "uni-app",
    "ui"
  ],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist/types --noEmit false",
    "lint": "eslint src/**/*.{ts,vue}",
    "test": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.9",
    "eslint": "^8.48.0",
    "eslint-plugin-vue": "^9.17.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "vitest": "^0.34.4",
    "vue": "^3.3.4"
  },
  "author": {
    "name": "PedroQue99",
    "email": "ksmengfang@163.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MengXi-Studio/uni-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MengXi-Studio/uni-ui.git"
  },
  "bugs": "https://github.com/MengXi-Studio/uni-ui/issues"
}
